        {
          "id": "e3aa9103-a1ed-4d28-8014-c6d0c2a8f09b",
          "name": "List commits",
          "request": {
            "name": "List commits",
            "description": {
              "content": "Lists all commits for a repository with pagination support.\nThis endpoint supports both authenticated and unauthenticated access.\nAuthenticated users can access private repos, while unauthenticated users can only access public repos.\nThe include_stats parameter controls whether download and view statistics are computed (defaults to true).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "commits",
                ":owner",
                ":repo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include_stats",
                  "value": "true",
                  "description": "IncludeStats determines whether to compute num_downloads and num_views"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Limit is the pagination limit"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset is the pagination offset"
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Tag filters commits to only those with a specific tag (e.g. \"production\", \"staging\")"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) Repository owner (tenant handle) or '-' for private repos"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo",
                  "description": "(Required) Repository handle"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
