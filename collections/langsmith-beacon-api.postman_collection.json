          "name": "Submit a self-hosted usage snapshot",
          "request": {
            "name": "Submit a self-hosted usage snapshot",
            "description": {
              "content": "Records aggregate entity counts (workspaces, projects, datasets, active users, etc.)\nfrom a self-hosted deployment. Called daily by installs where PHONE_HOME_ENABLED\nand PHONE_HOME_USAGE_REPORTING_ENABLED are set. Authenticates via license key.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "beacon",
                "usage-snapshot"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_timestamp\": \"<string>\",\n  \"license_key\": \"<string>\",\n  \"measures\": {\n    \"key_0\": \"<integer>\"\n  },\n  \"to_timestamp\": \"<string>\"\n}",
